{
  "expo": {
    "name": "GrowHere",
    "slug": "growhere",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/images/icon.png",
    "scheme": "growhere",
    "userInterfaceStyle": "automatic",
    "backgroundColor": "#EDF1EA",
    "ios": {
      "bundleIdentifier": "com.growhere.app",
      "icon": "./assets/expo.icon",
      "infoPlist": {
        "NSCameraUsageDescription": "GrowHere potrebuje kamero, da fotografira sobo.",
        "NSPhotoLibraryUsageDescription": "GrowHere potrebuje dostop do galerije, da lahko izbereš sliko sobe.",
        "NSLocationWhenInUseUsageDescription": "Lokacija je potrebna za izračun poti sonca in kompas."
      }
    },
    "android": {
      "package": "com.growhere.app",
      "adaptiveIcon": {
        "backgroundColor": "#EDF1EA",
        "foregroundImage": "./assets/images/android-icon-foreground.png",
        "backgroundImage": "./assets/images/android-icon-background.png",
        "monochromeImage": "./assets/images/android-icon-monochrome.png"
      },
      "predictiveBackGestureEnabled": false,
      "permissions": ["CAMERA", "ACCESS_COARSE_LOCATION", "ACCESS_FINE_LOCATION"]
    },
    "web": {
      "output": "static",
      "favicon": "./assets/images/favicon.png"
    },
    "plugins": [
      "expo-router",
      [
        "expo-splash-screen",
        {
          "backgroundColor": "#EDF1EA",
          "image": "./assets/images/splash-icon.png",
          "imageWidth": 96
        }
      ],
      [
        "expo-image-picker",
        {
          "cameraPermission": "GrowHere potrebuje kamero, da fotografira sobo.",
          "photosPermission": "GrowHere potrebuje dostop do galerije, da lahko izbereš sliko sobe."
        }
      ],
      [
        "expo-location",
        {
          "locationWhenInUsePermission": "Lokacija je potrebna za izračun poti sonca in kompas."
        }
      ],
      [
        "expo-notifications",
        {
          "icon": "./assets/images/icon.png",
          "color": "#2E5B3B"
        }
      ]
    ],
    "experiments": {
      "typedRoutes": true,
      "reactCompiler": true
    }
  }
}
